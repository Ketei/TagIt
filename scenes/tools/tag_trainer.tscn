[sub_resource type="GDScript" id="GDScript_0vdg4"]
script/source = "class_name TvecTester
extends Node

const TVEC_PATH: String = \"user://tag_vectors.tvec\"
const DIMENSIONS: int = 128

# Added: Inspector inputs for testing 1-5 tags
@export var test_tags: PackedStringArray = PackedStringArray()
@export_range(1, 25) var top_n: int = 5

var tag_names: PackedStringArray = PackedStringArray()
var tag_to_index: Dictionary[String, int] = {}
var flat_vectors: PackedFloat32Array = PackedFloat32Array()


func perform_test() -> void:
	if not load_tvec(TVEC_PATH):
		push_error(\"Failed to load \" + TVEC_PATH)
		return
	
	print(\"Loaded %d tags from %s\" % [tag_names.size(), TVEC_PATH])
	
	var cleaned_query := PackedStringArray()
	for raw_tag: String in test_tags:
		var normalized: String = raw_tag.strip_edges().to_lower()
		if not normalized.is_empty():
			cleaned_query.append(normalized)
		if cleaned_query.size() >= 5:
			break
	
	if cleaned_query.is_empty():
		print(\"No tags set in 'test_tags' Inspector property.\")
		return
	
	print_neighbors(cleaned_query, top_n)


func load_tvec(path: String) -> bool:
	if not FileAccess.file_exists(path):
		return false
	var file := FileAccess.open(path, FileAccess.READ)
	if file == null:
		return false
	
	if file.get_buffer(4).get_string_from_ascii() != \"TVEC\":
		return false
	
	var _version: int = file.get_32()
	var dims: int = file.get_32()
	var count: int = file.get_32()
	if dims != DIMENSIONS or count <= 0:
		return false
	
	tag_names.clear()
	tag_to_index.clear()
	
	for i: int in range(count):
		var str_len: int = file.get_16()
		var tag_str: String = file.get_buffer(str_len).get_string_from_utf8()
		tag_names.append(tag_str)
		tag_to_index[tag_str] = i
	
	var total_floats: int = count * DIMENSIONS
	flat_vectors = file.get_buffer(total_floats * 4).to_float32_array()
	file.close()
	
	return flat_vectors.size() == total_floats


func print_neighbors(query_tags: PackedStringArray, result_count: int = 5) -> void:
	for tag: String in query_tags:
		if not tag_to_index.has(tag):
			print(\"Warning: Tag '%s' was not found in .tvec vocabulary.\" % tag)
	
	var centroid := _build_centroid(query_tags)
	if centroid.is_empty():
		print(\"None of the query tags exist in the .tvec file: \", query_tags)
		return
	
	var results: Array[Dictionary] = []
	for i: int in range(tag_names.size()):
		var candidate: String = tag_names[i]
		if query_tags.has(candidate):
			continue
		var score: float = _dot_product(centroid, i)
		results.append({ \"tag\": candidate, \"score\": score })
	
	results.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return a[\"score\"] > b[\"score\"])
	
	print(\"\\n--- Query: %s ---\" % [\", \".join(query_tags)])
	var limit: int = mini(result_count, results.size())
	for i: int in range(limit):
		print(\"  %d. %s (score: %.4f)\" % [i + 1, results[i][\"tag\"], results[i][\"score\"]])


func _build_centroid(query_tags: PackedStringArray) -> PackedFloat32Array:
	var centroid := PackedFloat32Array()
	centroid.resize(DIMENSIONS)
	centroid.fill(0.0)
	
	var valid_count: int = 0
	for tag: String in query_tags:
		if not tag_to_index.has(tag):
			continue
		var offset: int = tag_to_index[tag] * DIMENSIONS
		for d: int in range(DIMENSIONS):
			centroid[d] += flat_vectors[offset + d]
		valid_count += 1
	
	if valid_count == 0:
		return PackedFloat32Array()
	
	var mag_sq: float = 0.0
	for d: int in range(DIMENSIONS):
		mag_sq += centroid[d] * centroid[d]
	
	if mag_sq > 0.000001:
		var inv_mag: float = 1.0 / sqrt(mag_sq)
		for d: int in range(DIMENSIONS):
			centroid[d] *= inv_mag
	
	return centroid


func _dot_product(query_vec: PackedFloat32Array, tag_index: int) -> float:
	var offset: int = tag_index * DIMENSIONS
	var sum: float = 0.0
	for d: int in range(DIMENSIONS):
		sum += query_vec[d] * flat_vectors[offset + d]
	return sum
"


[sub_resource type="GDScript" id="GDScript_xy1vp"]
script/source = "extends RichTextLabel


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var menu: PopupMenu = get_menu()
	menu.clear()
	menu.add_item(\"Copy Tags\", MENU_MAX + 1)
	menu.id_pressed.connect(_on_item_id_pressed)
	menu.about_to_popup.connect(setup_menu)


func setup_menu() -> void:
	get_menu().set_item_disabled(0, text.is_empty())


func _on_item_id_pressed(id: int) -> void:
	match id:
		1 + MENU_MAX:
			DisplayServer.clipboard_set(text)
"

